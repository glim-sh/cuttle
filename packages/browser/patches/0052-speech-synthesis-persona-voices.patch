+bool CuttlePersonaVoicesEnabled() {
+  auto* cl = base::CommandLine::ForCurrentProcess();
+  if (!cl->HasSwitch(clark::switches::kFingerprint) &&
+      !cl->HasSwitch(clark::switches::kFingerprintPlatform)) {
+    return false;
+  }
+  // Opt-out, mirroring --fingerprint-noise: absent means on.
+  const std::string value =
+      cl->GetSwitchValueASCII(clark::switches::kFingerprintVoices);
+  return value != "false" && value != "0";
+}
+
+bool CuttlePersonaIsMacOS() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+             clark::switches::kFingerprintPlatform) == "macos";
+}
+
+template <size_t N>
+void CuttleAppendVoices(Vector<mojom::blink::SpeechSynthesisVoicePtr>& out,
+                       const CuttleVoice (&table)[N]) {
+  for (const CuttleVoice& entry : table) {
+    auto voice = mojom::blink::SpeechSynthesisVoice::New();
+    voice->voice_uri = entry.name;
+    voice->name = entry.name;
+    voice->lang = entry.lang;
+    voice->is_local_service = entry.local;
+    voice->is_default = false;
+    out.push_back(std::move(voice));
+  }
+}
+
+// Measured on both references, at every stage including the transient
+// Windows one: exactly one voice carries default, and it is always the first
+// entry of the list as it currently stands. Deriving it here rather than
+// flagging a name in the tables keeps that a single source of truth - a
+// hardcoded default would report none at all during the Windows two-stage
+// delivery, where the network voices arrive before any local one.
+void CuttlePublishVoices(HeapVector<Member<SpeechSynthesisVoice>>& list,
+                        Vector<mojom::blink::SpeechSynthesisVoicePtr> voices) {
+  if (!voices.empty()) {
+    voices[0]->is_default = true;
+  }
+  list.clear();
+  for (auto& voice : voices) {
+    list.push_back(
+        MakeGarbageCollected<SpeechSynthesisVoice>(std::move(voice)));
+  }
+}

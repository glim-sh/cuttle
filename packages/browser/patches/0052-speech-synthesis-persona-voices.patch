+
+// cuttle #52: measured delivery order. macOS dispatched a single
+// voiceschanged carrying the system voices followed by the network voices.
+// Windows dispatched twice - the network voices first, then again once SAPI had
+// enumerated its locals, which land ahead of them in the final list.
+void SpeechSynthesis::CuttleInstallPersonaVoices() {
+  Vector<mojom::blink::SpeechSynthesisVoicePtr> voices;
+  if (CuttlePersonaIsMacOS()) {
+    CuttleAppendVoices(voices, kCuttleMacLocalVoices);
+    CuttleAppendVoices(voices, kCuttleRemoteVoices);
+    CuttlePublishVoices(voice_list_, std::move(voices));
+    VoicesDidChange();
+    return;
   }
+  CuttleAppendVoices(voices, kCuttleRemoteVoices);
+  CuttlePublishVoices(voice_list_, std::move(voices));
   VoicesDidChange();
+  GetSupplementable()
+      ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+      ->PostTask(FROM_HERE,
+                 BindOnce(&SpeechSynthesis::CuttleAppendLocalVoices,
+                          WrapWeakPersistent(this)));
 }
 
+void SpeechSynthesis::CuttleAppendLocalVoices() {
+  Vector<mojom::blink::SpeechSynthesisVoicePtr> voices;
+  CuttleAppendVoices(voices, kCuttleWinLocalVoices);
+  CuttleAppendVoices(voices, kCuttleRemoteVoices);
+  CuttlePublishVoices(voice_list_, std::move(voices));
+  VoicesDidChange();
+}

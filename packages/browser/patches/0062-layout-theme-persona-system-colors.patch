 }
 
+// cuttle-stealth #62: the CSS system colours of real Chrome on the persona's
+// OS where they differ from the Linux build's stock palette
+// (ui/color/color_provider_utils.cc CompleteDefaultCssSystemColorDefinition).
+//
+// Windows, light mode: ui/color/win/css_system_color_mixer_win.cc replaces the
+// stock palette with GetSysColor() values, which on the default theme are the
+// ones content/child/webthemeengine_impl_default_browsertest.cc asserts and a
+// real Windows 11 PC measured: ActiveText, LinkText and VisitedText all
+// COLOR_HOTLIGHT #0066CC, ButtonFace and its aliases #F0F0F0, GrayText
+// #6D6D6D, Highlight the default accent #0078D4. The stock red ActiveText is
+// CreepJS's hasKnownBgColor headless tell. In dark mode the mixer keeps the
+// stock palette, but layout_theme_win.cc still returns Highlight without the
+// BlendWithWhite() every other platform applies.
+//
+// macOS: ui/color/mac/css_system_color_mixer_mac.mm pins Highlight to #B3D7FF
+// and HighlightText to black in both modes, and LayoutThemeMac blends that
+// Highlight with white in light mode and gives it .8 alpha in dark.
+// SelectedItem/SelectedItemText in light mode come from LayoutThemeMac's
+// selection colours: the system selectedTextBackgroundColor (#B3D7FF with the
+// default blue accent) and black. Their dark values are defaults shared with
+// Linux. All measured on real Chrome 154 on a Mac, light and dark.
+//
+// Only over the stock palette: every forced-colors palette maps ActiveText to
+// its own Hotlight, never to the stock red, so those keep Chromium's values.
+enum class CuttlePersona { kNone, kWindows, kMacOS };
+
+CuttlePersona CurrentCuttlePersona() {
+  static const CuttlePersona kPersona = [] {
+    const std::string platform =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            cuttle::switches::kFingerprintPlatform);
+    if (platform == "windows") {
+      return CuttlePersona::kWindows;
+    }
+    if (platform == "macos") {
+      return CuttlePersona::kMacOS;
+    }
+    return CuttlePersona::kNone;
+  }();
+  return kPersona;
+}
+
+std::optional<Color> CuttlePersonaSystemColor(
+    CSSValueID css_value_id,
+    mojom::blink::ColorScheme color_scheme,
+    const ui::ColorProvider* color_provider) {
+  const CuttlePersona persona = CurrentCuttlePersona();
+  if (persona == CuttlePersona::kNone ||
+      color_provider->GetColor(ui::kColorCssSystemActiveText) !=
+          SK_ColorRED) {
+    return std::nullopt;
+  }
+  const bool dark = color_scheme == mojom::blink::ColorScheme::kDark;
+  if (persona == CuttlePersona::kWindows) {
+    if (css_value_id == CSSValueID::kHighlight) {
+      return Color::FromRGBA32(dark ? 0xFF1967D2 : 0xFF0078D4);
+    }
+    if (dark) {
+      return std::nullopt;
+    }
+    switch (css_value_id) {
+      case CSSValueID::kActivetext:
+      case CSSValueID::kLinktext:
+      case CSSValueID::kVisitedtext:
+        return Color::FromRGBA32(0xFF0066CC);
+      case CSSValueID::kButtonface:
+      case CSSValueID::kButtonhighlight:
+      case CSSValueID::kButtonshadow:
+      case CSSValueID::kThreedface:
+        return Color::FromRGBA32(0xFFF0F0F0);
+      case CSSValueID::kGraytext:
+        return Color::FromRGBA32(0xFF6D6D6D);
+      default:
+        return std::nullopt;
+    }
+  }
+  switch (css_value_id) {
+    case CSSValueID::kHighlight:
+      return dark ? Color(0xB3, 0xD7, 0xFF, 204)
+                  : Color::FromRGBA32(0xFFB3D7FF).BlendWithWhite();
+    case CSSValueID::kHighlighttext:
+      return Color::kBlack;
+    case CSSValueID::kSelecteditem:
+      return dark ? std::nullopt
+                  : std::optional<Color>(Color::FromRGBA32(0xFFB3D7FF));
+    case CSSValueID::kSelecteditemtext:
+      return dark ? std::nullopt : std::optional<Color>(Color::kBlack);
+    default:
+      return std::nullopt;
+  }
+}
+
 }  // namespace
 

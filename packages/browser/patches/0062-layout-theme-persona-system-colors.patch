 namespace blink {
 
+namespace {
+
+// cuttle-stealth #62: on Windows, layout_theme_font_provider_win.cc takes the
+// menu, small-caption and status-bar system fonts from the OS
+// (NONCLIENTMETRICS via FontCache), which is Segoe UI 9pt, i.e. 12px - measured
+// on real Chrome 154 on Windows 11. The other keywords, and every keyword on a
+// Mac, use DefaultGUIFont() at the default size, as this file already does.
+bool CuttleIsWindowsNonClientFont(CSSValueID system_font_id) {
+  static const bool kIsWindows =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          cuttle::switches::kFingerprintPlatform) == "windows";
+  return kIsWindows && (system_font_id == CSSValueID::kSmallCaption ||
+                        system_font_id == CSSValueID::kMenu ||
+                        system_font_id == CSSValueID::kStatusBar);
+}
+
+}  // namespace
+
 // static
 const AtomicString& LayoutThemeFontProvider::SystemFontFamily(
     CSSValueID system_font_id) {
+  if (CuttleIsWindowsNonClientFont(system_font_id)) {
+    DEFINE_THREAD_SAFE_STATIC_LOCAL(const AtomicString, segoe_ui,
+                                    ("Segoe UI"));
+    return segoe_ui;
+  }
   return DefaultGUIFont();
 }
 

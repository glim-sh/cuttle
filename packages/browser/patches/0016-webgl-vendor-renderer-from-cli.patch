+// cuttle-stealth #21: +/-1 on one colour channel of each visible pixel that
+// differs from its right or next-row neighbour, keyed on the seed and the
+// pixel's framebuffer coordinates. Overlapping reads agree, and a clear or
+// solid fill reads back exact. `image` is the validated RGBA/UNSIGNED_BYTE
+// destination: `height` rows of `width` pixels, `row_stride` bytes apart.
+void CuttleNoiseReadPixels(base::span<uint8_t> image,
+                           GLint x,
+                           GLint y,
+                           GLsizei width,
+                           GLsizei height,
+                           size_t row_stride) {
+  static const uint64_t kSeedKey = cuttle::seed::Hash("webgl-rp");
+  const size_t rows = static_cast<size_t>(height);
+  const size_t cols = static_cast<size_t>(width);
+  const size_t row_bytes = cols * 4;
+  // Raster order compares each pixel only with neighbours not yet noised.
+  for (size_t row = 0; row + 1 < rows; ++row) {
+    const base::span<uint8_t> px = image.subspan(row * row_stride, row_bytes);
+    const base::span<const uint8_t> next_row =
+        image.subspan((row + 1) * row_stride, row_bytes);
+    for (size_t col = 0; col + 1 < cols; ++col) {
+      const size_t at = col * 4;
+      if (px[at + 3] == 0) {
+        continue;
+      }
+      const auto same = [&](base::span<const uint8_t> other) {
+        return other[0] == px[at] && other[1] == px[at + 1] &&
+               other[2] == px[at + 2] && other[3] == px[at + 3];
+      };
+      if (same(px.subspan(at + 4, 4u)) && same(next_row.subspan(at, 4u))) {
+        continue;
+      }
+      // splitmix64's finalizer over (seed, x, y).
+      uint64_t z = kSeedKey ^
+                   (static_cast<uint64_t>(static_cast<uint32_t>(x) +
+                                          static_cast<uint32_t>(col))
+                    << 32) ^
+                   static_cast<uint32_t>(static_cast<uint32_t>(y) +
+                                         static_cast<uint32_t>(row));
+      z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+      z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+      z ^= z >> 31;
+      uint8_t& channel = px[at + z % 3];
+      const bool up = channel == 0 || (channel != 255 && ((z >> 8) & 1));
+      channel = static_cast<uint8_t>(up ? channel + 1 : channel - 1);
+    }
+  }
+}

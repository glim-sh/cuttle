+bool CuttleHasFingerprint() {
+  auto* cl = base::CommandLine::ForCurrentProcess();
+  return cl->HasSwitch(cuttle::switches::kFingerprint) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintPlatform) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintGpuVendor) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintGpuRenderer);
+}
+
+std::string CuttleFingerprintPlatform() {
+  auto* cl = base::CommandLine::ForCurrentProcess();
+  std::string platform =
+      cl->GetSwitchValueASCII(cuttle::switches::kFingerprintPlatform);
+  if (platform == "macos" || platform == "linux")
+    return platform;
+  return "windows";
+}
+
+const CuttleGpuPoolEntry& CuttlePickGpu() {
+  const std::string platform = CuttleFingerprintPlatform();
+  size_t candidate_count = 0;
+  for (const auto& entry : kCuttleGpuPool) {
+    if (platform == entry.platform)
+      ++candidate_count;
+  }
+  if (candidate_count == 0)
+    return kCuttleGpuPool[0];
+
+  size_t pick =
+      static_cast<size_t>(cuttle::seed::Hash("webgl-pool") % candidate_count);
+  for (const auto& entry : kCuttleGpuPool) {
+    if (platform != entry.platform)
+      continue;
+    if (pick == 0)
+      return entry;
+    --pick;
+  }
+  return kCuttleGpuPool[0];
+}

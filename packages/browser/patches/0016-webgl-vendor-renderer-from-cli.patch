+struct Persona {
+  Backend backend = Backend::kNone;
+  int64_t max_samples = 0;
+};
+
+// Keyed on --fingerprint-gpu-renderer, which the daemon always passes. Any
+// D3D11 or Apple Metal renderer gets its backend's table; an untabled D3D11
+// GPU keeps the common MAX_SAMPLES of 8.
+inline Persona ComputePersona() {
+  const std::string renderer =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          cuttle::switches::kFingerprintGpuRenderer);
+  for (const D3D11Device& device : kD3D11Devices) {
+    if (renderer == device.renderer) {
+      return {Backend::kD3D11, device.max_samples};
+    }
+  }
+  if (renderer.find(" Direct3D11 ") != std::string::npos) {
+    return {Backend::kD3D11, 8};
+  }
+  if (renderer.rfind("ANGLE (Apple, ANGLE Metal Renderer: Apple ", 0) == 0) {
+    return {Backend::kMetal, 4};  // measured on the M1 Max
+  }
+  return {};
+}
+
+inline const Persona& ActivePersona() {
+  static const Persona persona = ComputePersona();
+  return persona;
+}
+
+inline Backend ActiveBackend() {
+  return ActivePersona().backend;
+}
+
+// Fills the persona's value for a numeric cap. False leaves the backend value.
+inline bool LookupCap(uint32_t pname, int64_t* v0, int64_t* v1) {
+  const Persona& persona = ActivePersona();
+  if (persona.backend == Backend::kNone) {
+    return false;
+  }
+  if (pname == 0x8D57) {  // MAX_SAMPLES
+    *v0 = persona.max_samples;
+    *v1 = 0;
+    return true;
+  }
+  for (const Cap& cap : kCaps) {
+    if (cap.pname == pname) {
+      const int64_t* v =
+          persona.backend == Backend::kD3D11 ? cap.d3d11 : cap.metal;
+      *v0 = v[0];
+      *v1 = v[1];
+      return true;
+    }
+  }
+  return false;
+}
+
+// Both backends report full 32-bit precision for every precision qualifier;
+// SwiftShader reports 16-bit mediump and lowp.
+inline bool LookupPrecision(bool is_int,
+                            int* range_min,
+                            int* range_max,
+                            int* precision) {
+  if (ActiveBackend() == Backend::kNone) {
+    return false;
+  }
+  *range_min = is_int ? 31 : 127;
+  *range_max = is_int ? 30 : 127;
+  *precision = is_int ? 0 : 23;
+  return true;
+}
+
+inline bool ExtensionAllowed(std::string_view name, bool webgl2) {
+  auto contains = [name](const auto& list) {
+    for (std::string_view allowed : list) {
+      if (allowed == name) {
+        return true;
+      }
+    }
+    return false;
+  };
+  switch (ActiveBackend()) {
+    case Backend::kD3D11:
+      return webgl2 ? contains(kD3D11WebGL2Extensions)
+                    : contains(kD3D11WebGL1Extensions);
+    case Backend::kMetal:
+      return webgl2 ? contains(kMetalWebGL2Extensions)
+                    : contains(kMetalWebGL1Extensions);
+    case Backend::kNone:
+      return true;
+  }
+  return true;
+}

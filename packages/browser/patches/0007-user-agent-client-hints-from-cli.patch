+UserAgentBrandList CuttleNavigatorShuffleBrandList(UserAgentBrandList list, int seed) {
+  const size_t index = static_cast<size_t>(seed);
+  std::vector<size_t> order;
+  if (list.size() == 2) {
+    order = {index % 2, (index + 1) % 2};
+  } else {
+    static constexpr std::array<std::array<size_t, 3>, 6> kOrders{
+        {{0, 1, 2}, {0, 2, 1}, {1, 0, 2}, {1, 2, 0}, {2, 0, 1}, {2, 1, 0}}};
+    const std::array<size_t, 3>& picked = kOrders[index % kOrders.size()];
+    order.assign(picked.begin(), picked.end());
+  }
+  UserAgentBrandList shuffled(list.size());
+  for (size_t i = 0; i < order.size(); i++)
+    shuffled[order[i]] = list[i];
+  return shuffled;
+}

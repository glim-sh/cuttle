+// embedder copy, so a value hardcoded here makes navigator.userAgentData.brands
+// contradict that header, which no real Chrome ever does.
+UserAgentBrandVersion CuttleNavigatorGreasedBrand(int seed, bool full_version) {
+  static constexpr std::array<const char*, 11> kGreasyChars{
+      {" ", "(", ":", "-", ".", "/", ")", ";", "=", "?", "_"}};
+  static constexpr std::array<const char*, 3> kGreasedVersions{{"8", "99", "24"}};
+  const size_t index = static_cast<size_t>(seed);
+  const std::string version = kGreasedVersions[index % kGreasedVersions.size()];
+  return {base::StrCat({"Not", kGreasyChars[index % kGreasyChars.size()], "A",
+                        kGreasyChars[(index + 1) % kGreasyChars.size()], "Brand"}),
+          full_version ? base::StrCat({version, ".0.0.0"}) : version};

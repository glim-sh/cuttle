# cuttle stealth-chromium patch #68 - drop the test-only managed-profile call
# that breaks the 156 link under ungoogled.
#
# Source: chromium 156.0.8078.47 + ungoogled-chromium 156.0.8078.47-1
#   chrome/browser/enterprise/signin/profile_management_disclaimer_service.cc
#
# ungoogled's remove-unused-preferences-fields.patch takes
# signin/managed_profile_creation_controller.cc out of the build and removes the
# production CreateManagedProfile() call, but 156 added a second, test-only
# caller in OnProfileSeparationPoliciesFetched, so the chrome link fails on an
# undefined CreateManagedProfileForTesting. That branch is behind CHECK_IS_TEST()
# and never runs in a shipped binary; keep the guard and the early return, drop
# the call. Remove this patch once ungoogled fixes it.
--- a/chrome/browser/enterprise/signin/profile_management_disclaimer_service.cc
+++ b/chrome/browser/enterprise/signin/profile_management_disclaimer_service.cc
@@ -657,16 +657,6 @@
   if (profile_separation_policies_for_testing_.has_value() ||
       user_choice_for_testing_.has_value()) {
     CHECK_IS_TEST();
-    state_->profile_creation_controller =
-        ManagedProfileCreationController::CreateManagedProfileForTesting(
-            &profile_.get(), GetExtendedAccountInfo(state_->account_id),
-            *state_->access_point,
-            base::BindOnce(&ProfileManagementDisclaimerService::
-                               OnManagedProfileCreationResult,
-                           weak_ptr_factory_.GetWeakPtr()),
-            profile_separation_policies_for_testing_.value_or(
-                std::move(profile_separation_policies)),
-            user_choice_for_testing_);
     return;
   }
 

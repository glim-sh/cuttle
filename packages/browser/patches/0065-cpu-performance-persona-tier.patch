# cuttle stealth-chromium patch #65 - navigator.cpuPerformance from the persona.
#
# Source: chromium 154.0.8037.57
#   content/browser/cpu_performance/cpu_performance.cc
#
# Authored for cuttle, not derived from the clark series.
#
# navigator.cpuPerformance (stable since 154, [SecureContext]) reports a tier
# the browser computes once from base::SysInfo: the host's core count and CPU
# model. In a container that is the build host's CPU, beside a persona whose
# hardwareConcurrency and WebGL GPU describe a different machine. Real Chrome
# 154 on an Apple M1 Max (10 cores) reports 4, the Apple M rule; the host
# fallback there would report 3.
#
# With a persona active this computes the tier through the upstream
# GetTierFromCpuInfo from the persona's cores and, on an Apple GPU, the chip
# named in the WebGL renderer. It never reads the host, so it also skips the
# blocking /proc/cpuinfo task.
diff --git a/content/browser/cpu_performance/cpu_performance.cc b/content/browser/cpu_performance/cpu_performance.cc
--- a/content/browser/cpu_performance/cpu_performance.cc
+++ b/content/browser/cpu_performance/cpu_performance.cc
@@ -6,12 +6,15 @@
 
 #include <optional>
 

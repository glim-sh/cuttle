 #include "base/functional/bind.h"
 #include "base/no_destructor.h"
 #include "base/strings/string_util.h"
 #include "base/synchronization/lock.h"
 #include "base/system/sys_info.h"
 #include "base/task/thread_pool.h"
+#include "third_party/blink/common/cuttle_fingerprint_switches.h"
+#include "third_party/blink/common/cuttle_seed.h"
 #include "third_party/blink/public/common/features.h"
 #include "third_party/re2/src/re2/re2.h"
 
@@ -188,6 +191,38 @@
   GetCpuInfoState().tier = tier;
 }
 
+// cuttle-stealth: with a persona active, the tier is the one the persona's
+// machine would report, not the host's. The cores are the persona's
+// navigator.hardwareConcurrency (patch 0006): the switch, else the seed. There
+// is no CPU model switch, but an Apple Metal WebGL renderer names the chip
+// ("Apple M2 Pro"), which is also the brand string a real Mac reports, and that
+// model is what lifts an 8-10 core Mac from kHigh to kUltra. Any other GPU
+// leaves the model empty, which tiers by cores exactly as a model with no
+// special rule does. Returns false with no persona active.
+bool InitializeFromPersona() {
+  auto* cl = base::CommandLine::ForCurrentProcess();
+  if (!cl->HasSwitch(cuttle::switches::kFingerprintHardwareConcurrency) &&
+      !cl->HasSwitch(cuttle::switches::kFingerprint)) {
+    return false;
+  }
+  const int cores = static_cast<int>(cuttle::seed::HardwareConcurrency());
+
+  std::string model;
+  const std::string renderer =
+      cl->GetSwitchValueASCII(cuttle::switches::kFingerprintGpuRenderer);
+  if (const size_t start = renderer.find("Apple M");
+      start != std::string::npos) {
+    model = renderer.substr(start, renderer.find_first_of(",)", start) - start);
+  }
+  Tier tier = GetTierFromCpuInfo(model, cores);
+
+  base::AutoLock auto_lock(GetCpuInfoState().lock);
+  GetCpuInfoState().model = std::move(model);
+  GetCpuInfoState().cores = cores;
+  GetCpuInfoState().tier = tier;
+  return true;
+}
+
 }  // anonymous namespace
 
 Tier GetTier() {
@@ -207,6 +242,10 @@
 
 void Initialize() {
   if (base::FeatureList::IsEnabled(blink::features::kCpuPerformance)) {
+    if (InitializeFromPersona()) {
+      return;
+    }
+
     // Use a simple, default implementation which is non-blocking, so that we
     // have a reasonable computed value in the unlikely case that the tier is

# cuttle-stealth-chromium patch #40 - flip net stealth defaults
# Source: chromium 154.0.8037.57 net/base/features.cc
# Idea: ungoogled-chromium ships kSetIpv6ProbeFalse disabled by default.
# Enable it so the resolver never runs its IPv6 reachability probe.
# ungoogled's referrer features (kMinimalReferrers, kNoCrossOriginReferrers)
# stay off: real Chrome sends strict-origin-when-cross-origin referrers, and
# stripping them broke same-origin POST Origin checks.
diff --git a/net/base/features.cc b/net/base/features.cc
--- a/net/base/features.cc
+++ b/net/base/features.cc
@@ -29,7 +29,7 @@
 
 namespace net::features {
 
-BASE_FEATURE(kSetIpv6ProbeFalse, "SetIpv6ProbeFalse", base::FEATURE_DISABLED_BY_DEFAULT);
+BASE_FEATURE(kSetIpv6ProbeFalse, "SetIpv6ProbeFalse", base::FEATURE_ENABLED_BY_DEFAULT);  // cuttle-stealth: no IPv6 probe leak
 
 BASE_FEATURE(kAlpsForHttp2, base::FEATURE_ENABLED_BY_DEFAULT);
 

# cuttle-stealth-chromium patch #48 — Permissions API default = "prompt"
# Source: chromium 151.0.7922.137
#   third_party/blink/renderer/modules/permissions/permission_status.cc
#   third_party/blink/renderer/modules/permissions/permission_status_listener.cc
#   third_party/blink/renderer/modules/permissions/permission_status_listener.h
# Idea: stock/headless Chromium can surface "denied" for promptable
# permissions. Bot detectors flag the headless auto-deny; "prompt" matches a
# fresh real Chrome profile before the user decides.
#
# 151 rebase: PermissionStatusListener::status_ changed from a plain enum
# (MojoPermissionStatus) to a mojo StructPtr (MojoPermissionStatusWithDetails =
# PermissionStatusWithDetailsPtr). The helper therefore MUTATES the StructPtr in
# place instead of taking and returning it by value: a StructPtr is move-only, so
# round-tripping it through a return type fights the ownership model. Mutating
# the incoming status before the Equals() compare also means observers receive
# the already-normalised status_.Clone() with no further change needed.
diff --git a/third_party/blink/renderer/modules/permissions/permission_status.cc b/third_party/blink/renderer/modules/permissions/permission_status.cc
--- a/third_party/blink/renderer/modules/permissions/permission_status.cc
+++ b/third_party/blink/renderer/modules/permissions/permission_status.cc
@@ -104,6 +104,8 @@
 V8PermissionState PermissionStatus::state() const {
+  // cuttle-stealth #48: default to "prompt" instead of "denied" so bot
+  // detectors don't see the headless-mode auto-deny tell.
   if (!listener_) {
-    return V8PermissionState(V8PermissionState::Enum::kDenied);
+    return V8PermissionState(V8PermissionState::Enum::kPrompt);
   }
   return listener_->state();
 }
diff --git a/third_party/blink/renderer/modules/permissions/permission_status_listener.cc b/third_party/blink/renderer/modules/permissions/permission_status_listener.cc
--- a/third_party/blink/renderer/modules/permissions/permission_status_listener.cc
+++ b/third_party/blink/renderer/modules/permissions/permission_status_listener.cc
@@ -5,6 +5,8 @@
 #include "third_party/blink/renderer/modules/permissions/permission_status_listener.h"
 
+#include "base/command_line.h"
 #include "base/task/single_thread_task_runner.h"
+#include "chrome/common/cuttle_fingerprint_switches.h"
 #include "mojo/public/cpp/bindings/remote.h"
 #include "third_party/blink/public/mojom/permissions/permission_status.mojom-blink.h"
 #include "third_party/blink/renderer/bindings/core/v8/v8_permission_state.h"
@@ -14,6 +16,47 @@
 namespace blink {
 
+namespace {
+
+bool CuttlePermissionPromptDefaultEnabled() {
+  auto* cl = base::CommandLine::ForCurrentProcess();
+  return cl->HasSwitch(cuttle::switches::kFingerprint) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintPlatform) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintBrand) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintBrandVersion);
+}
+
+bool CuttlePromptablePermission(
+    const mojom::blink::PermissionDescriptor& descriptor) {
+  switch (descriptor.name) {
+    case mojom::blink::PermissionName::NOTIFICATIONS:
+    case mojom::blink::PermissionName::GEOLOCATION:
+    case mojom::blink::PermissionName::AUDIO_CAPTURE:
+    case mojom::blink::PermissionName::VIDEO_CAPTURE:
+    case mojom::blink::PermissionName::CLIPBOARD_READ:
+    case mojom::blink::PermissionName::CLIPBOARD_WRITE:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// cuttle-stealth #48: in fingerprint mode, headless can auto-deny promptable
+// permissions before the user has made a decision. Normalise DENIED -> ASK so
+// the Permissions API reads like a fresh real profile. Mutates in place: see
+// the 151-rebase note at the top of this patch.
+void CuttleApplyPermissionPromptDefault(
+    mojom::blink::PermissionStatusWithDetailsPtr& status,
+    const mojom::blink::PermissionDescriptor& descriptor) {
+  if (status && status->status == mojom::blink::PermissionStatus::DENIED &&
+      CuttlePermissionPromptDefaultEnabled() &&
+      CuttlePromptablePermission(descriptor)) {
+    status->status = mojom::blink::PermissionStatus::ASK;
+  }
+}
+
+}  // namespace
+
 PermissionStatusListener* PermissionStatusListener::Create(
     ExecutionContext* execution_context,
     MojoPermissionStatusWithDetails status,
     MojoPermissionDescriptor descriptor) {
@@ -30,7 +73,9 @@
     : ExecutionContextClient(execution_context),
       status_(std::move(status)),
       descriptor_(std::move(descriptor)),
-      receiver_(this, execution_context) {}
+      receiver_(this, execution_context) {
+  CuttleApplyPermissionPromptDefault(status_, *descriptor_);
+}
 PermissionStatusListener::~PermissionStatusListener() = default;
 
 void PermissionStatusListener::StartListening() {
@@ -66,5 +111,6 @@
 void PermissionStatusListener::OnPermissionStatusChange(
     MojoPermissionStatusWithDetails status) {
+  CuttleApplyPermissionPromptDefault(status, *descriptor_);
   if (status_.Equals(status)) {
     return;
   }
@@ -90,5 +136,11 @@
 }
 
+void PermissionStatusListener::SetStatus(
+    MojoPermissionStatusWithDetails status) {
+  CuttleApplyPermissionPromptDefault(status, *descriptor_);
+  status_ = std::move(status);
+}
+
 void PermissionStatusListener::AddObserver(Observer* observer) {
   if (observers_.empty())
     StartListening();

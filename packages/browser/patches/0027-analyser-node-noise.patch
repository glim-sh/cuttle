# cuttle-stealth-chromium patch #27 — seed-derived noise on AnalyserNode
# getFloatFrequencyData / getByteFrequencyData output.
#
# Detection sites that read the frequency domain via AnalyserNode instead of
# the AudioContext destination buffer would bypass patch #26. This patch
# applies one tiny seed-derived affine map (scale 1 +/- 1e-6, offset up to
# +/- 3.3e-3 dB) to each bin's decibel magnitude, so the frequency-domain hash
# diverges from stock Chrome while staying visually identical on a
# spectrogram. Both getters convert that one noised value the stock way, so
# byte data is still float data mapped through minDecibels/maxDecibels. With
# --fingerprint absent or --fingerprint-noise=false the map is the identity.
#
# Source: chromium 154.0.8037.57
#   third_party/blink/renderer/modules/webaudio/realtime_analyser.cc
diff --git a/third_party/blink/renderer/modules/webaudio/realtime_analyser.cc b/third_party/blink/renderer/modules/webaudio/realtime_analyser.cc
--- a/third_party/blink/renderer/modules/webaudio/realtime_analyser.cc
+++ b/third_party/blink/renderer/modules/webaudio/realtime_analyser.cc
@@ -33,6 +33,9 @@
 
 #include "base/compiler_specific.h"
 #include "media/base/audio_bus.h"
+#include "base/command_line.h"
+#include "third_party/blink/common/cuttle_fingerprint_switches.h"
+#include "third_party/blink/common/cuttle_seed.h"
 #include "third_party/blink/renderer/platform/audio/audio_bus.h"
 #include "third_party/blink/renderer/platform/audio/audio_utilities.h"
 #include "third_party/blink/renderer/platform/audio/vector_math.h"
@@ -44,6 +47,25 @@
 
 constexpr unsigned kDefaultFFTSize = 2048;
 constexpr unsigned kInputBufferSize = RealtimeAnalyser::kMaxFFTSize * 2;
+
+// cuttle-stealth #27: one seed-derived affine map on the decibel magnitude,
+// shared by the float and byte paths so the bytes stay the stock conversion
+// of the floats. The identity when noise is off.
+struct CuttleDecibelNoise {
+  double scale = 1.0;
+  double offset = 0.0;
+};
+
+CuttleDecibelNoise CuttleAnalyserNoise() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          cuttle::switches::kFingerprint) ||
+      !cuttle::seed::NoiseEnabled()) {
+    return {};
+  }
+  const uint64_t h = cuttle::seed::Hash("audio.analyser");
+  return {1.0 + (static_cast<double>(h & 0xFFFFu) - 32768.0) * 3.0e-11,
+          (static_cast<double>((h >> 16) & 0xFFFFu) - 32768.0) * 1.0e-7};
+}
 
 void ApplyWindow(base::span<float> p) {
   DCHECK(IsMainThread());
@@ -119,9 +141,12 @@
   const size_t len = std::min(source_length, destination_array->length());
   if (len > 0) {
     base::span<float> destination = destination_array->AsSpan();
+    const CuttleDecibelNoise noise = CuttleAnalyserNoise();
     for (unsigned i = 0; i < len; ++i) {
       const float linear_value = magnitude_buffer_[i];
-      const double db_mag = audio_utilities::LinearToDecibels(linear_value);
+      const double db_mag =
+          audio_utilities::LinearToDecibels(linear_value) * noise.scale +
+          noise.offset;
       destination[i] = static_cast<float>(db_mag);
     }
   }

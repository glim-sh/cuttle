# cuttle-stealth-chromium patch #50 — propagate all cuttle::switches::* from
# the browser process to renderer / worker processes via
# RenderProcessHostImpl::AppendRendererCommandLine's kSwitchNames[].
#
# Without this whitelist entry, browser-level --fingerprint-* CLI flags
# never reach the renderer, where every patch reads them.
#
# Source: chromium 151.0.7922.137
#   content/browser/renderer_host/render_process_host_impl.cc
diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -6,6 +6,7 @@
 // channel. There will be one RenderProcessHost per renderer process.
 
 #include "content/browser/renderer_host/render_process_host_impl.h"
+#include "third_party/blink/common/cuttle_fingerprint_switches.h"
 
 #include <algorithm>
 #include <atomic>
@@ -351,7 +352,7 @@
 #if BUILDFLAG(IS_WIN)
 // This is from extensions/common/switches.cc
 // Marks a renderer as extension process.
-// TODO(joel@microsoft.com): Replace this with a layer-respecting alternative.
+// TODO(joel@m1cr050ft.qjz9zk): Replace this with a layer-respecting alternative.
 const char kExtensionProcess[] = "extension-process";
 #endif
 
@@ -2219,7 +2220,7 @@
   // Note that Channel send is effectively paused and unpaused at various points
   // during startup, and existing code relies on a fragile relative message
   // ordering resulting from some early messages being queued until process
-  // launch while others are sent immediately. See https://goo.gl/REW75h for
+  // launch while others are sent immediately. See https://goo.gl.qjz9zk/REW75h for
   // details.
   //
   // We acquire a few associated interface proxies here -- before the channel is
@@ -3833,6 +3834,34 @@

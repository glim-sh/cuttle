# cuttle-stealth-chromium patch #50 - propagate all cuttle::switches::* from
# the browser process to renderer / worker processes via
# RenderProcessHostImpl::AppendRendererCommandLine's kSwitchNames[].
#
# Without this whitelist entry, browser-level --fingerprint-* CLI flags
# never reach the renderer, where every patch reads them.
#
# Source: chromium 154.0.8037.57
#   content/browser/renderer_host/render_process_host_impl.cc
diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -6,6 +6,7 @@
 // channel. There will be one RenderProcessHost per renderer process.
 
 #include "content/browser/renderer_host/render_process_host_impl.h"
+#include "third_party/blink/common/cuttle_fingerprint_switches.h"
 
 #include <algorithm>
 #include <atomic>
@@ -3858,6 +3859,30 @@
   // Propagate the following switches to the renderer command line (along
   // with any associated values) if present in the browser command line.
   static const char* const kSwitchNames[] = {
+      // cuttle-stealth: forward --fingerprint-* to renderer
+      cuttle::switches::kFingerprint,
+      cuttle::switches::kFingerprintPlatform,
+      cuttle::switches::kFingerprintPlatformVersion,
+      cuttle::switches::kFingerprintBrand,
+      cuttle::switches::kFingerprintBrandVersion,
+      cuttle::switches::kFingerprintGpuVendor,
+      cuttle::switches::kFingerprintGpuRenderer,
+      cuttle::switches::kFingerprintHardwareConcurrency,
+      cuttle::switches::kFingerprintDeviceMemory,
+      cuttle::switches::kFingerprintScreenWidth,
+      cuttle::switches::kFingerprintScreenHeight,
+      cuttle::switches::kFingerprintTaskbarHeight,
+      cuttle::switches::kFingerprintTimezone,
+      cuttle::switches::kFingerprintLocale,
+      cuttle::switches::kFingerprintWebrtcIp,
+      cuttle::switches::kFingerprintMaxTouchPoints,
+      cuttle::switches::kFingerprintNetworkProfile,
+      cuttle::switches::kFingerprintConnectionType,
+      cuttle::switches::kFingerprintEffectiveType,
+      cuttle::switches::kFingerprintRtt,
+      cuttle::switches::kFingerprintDownlink,
+      cuttle::switches::kFingerprintNoise,
+      cuttle::switches::kFingerprintVoices,
       switches::kDisableInProcessStackTraces,
       sandbox::policy::switches::kDisableLandlockSandbox,
       sandbox::policy::switches::kDisableSeccompFilterSandbox,

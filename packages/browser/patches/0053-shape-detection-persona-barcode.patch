+// clark-stealth #53: BarcodeDetector is exposed only on the macOS persona,
+// because real Chrome ships it on Mac/Android/ChromeOS and nowhere else. No
+// shape-detection backend exists in the Linux container, so the mojo pipe
+// disconnects and the spec's error path resolves an EMPTY format list - a
+// combination (interface present, zero formats) that no real Mac produces.
+//
+// This is what macOS actually reports: the Vision symbologies mapped through
+// ToBarcodeFormat() in barcode_detection_impl_mac_vision.mm and collected
+// into a base::flat_set, so the list arrives sorted by the mojom
+// BarcodeFormat enum ordinal. CODABAR and UPC_A are absent because Vision
+// exposes no symbology that maps onto them.
+constexpr V8BarcodeFormat::Enum kCuttleMacBarcodeFormats[] = {
+    V8BarcodeFormat::Enum::kAztec,      V8BarcodeFormat::Enum::kCode128,
+    V8BarcodeFormat::Enum::kCode39,     V8BarcodeFormat::Enum::kCode93,
+    V8BarcodeFormat::Enum::kDataMatrix, V8BarcodeFormat::Enum::kEan13,
+    V8BarcodeFormat::Enum::kEan8,       V8BarcodeFormat::Enum::kItf,
+    V8BarcodeFormat::Enum::kPdf417,     V8BarcodeFormat::Enum::kQrCode,
+    V8BarcodeFormat::Enum::kUpcE,
+};
+
+}  // namespace

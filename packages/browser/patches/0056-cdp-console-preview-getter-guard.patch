+// cuttle-stealth #56: while a driver has Runtime enabled, every console
+// argument and uncaught exception is previewed here, so any page getter this
+// file invokes is a read a page can count against a browser with no debugger.
+// Reads go through descriptors instead: proxies and page-defined getters stop
+// them, and only builtin getters run, which upstream already allowed.
+enum class OwnProperty { kAbsent, kData, kBuiltinAccessor, kUnsafe };
+
+OwnProperty inspectOwnProperty(v8::Local<v8::Context> context,
+                               v8::Local<v8::Object> object,
+                               v8::Local<v8::String> name,
+                               v8::Local<v8::Value>* value) {
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  if (object->IsProxy()) return OwnProperty::kUnsafe;
+  v8::Local<v8::Value> descriptor;
+  if (!object->GetOwnPropertyDescriptor(context, name).ToLocal(&descriptor)) {
+    return OwnProperty::kUnsafe;
+  }
+  if (!descriptor->IsObject()) return OwnProperty::kAbsent;
+  v8::Local<v8::Object> descriptorObject = descriptor.As<v8::Object>();
+  // Only own fields of the descriptor: a missing one would be looked up on
+  // Object.prototype, where the page can install a getter.
+  v8::Local<v8::String> getKey = toV8String(isolate, "get");
+  if (descriptorObject->HasOwnProperty(context, getKey).FromMaybe(false)) {
+    v8::Local<v8::Value> getter;
+    if (!descriptorObject->Get(context, getKey).ToLocal(&getter)) {
+      return OwnProperty::kUnsafe;
+    }
+    if (getter->IsUndefined()) return OwnProperty::kAbsent;
+    if (getter->IsFunction() && isBuiltinGetter(getter.As<v8::Function>())) {
+      return OwnProperty::kBuiltinAccessor;
+    }
+    return OwnProperty::kUnsafe;
+  }
+  if (!descriptorObject->Get(context, toV8String(isolate, "value"))
+           .ToLocal(value)) {
+    return OwnProperty::kUnsafe;
+  }
+  return OwnProperty::kData;
+}

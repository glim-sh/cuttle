+// Reading a stack that is not formatted yet formats it, and formatting runs
+// Error.prototype.toString on the stack holder (Get plus ToString of name and
+// message) and reads and calls Error.prepareStackTrace. The holder can be any
+// object on the chain, so every level must be inert, and name and message
+// must not be objects or symbols, whose ToString could reach page code.
+bool isStackFormattingInert(v8::Local<v8::Context> context,
+                            v8::Local<v8::Object> object) {
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  v8::TryCatch tryCatch(isolate);
+  v8::MicrotasksScope microtasksScope(context,
+                                      v8::MicrotasksScope::kDoNotRunMicrotasks);
+  v8::Local<v8::Context> checkedRealm;
+  for (v8::Local<v8::Value> holder = object; holder->IsObject();
+       holder = holder.As<v8::Object>()->GetPrototype()) {
+    for (const char* key : {"name", "message"}) {
+      v8::Local<v8::Value> value;
+      OwnProperty kind = inspectOwnProperty(context, holder.As<v8::Object>(),
+                                            toV8String(isolate, key), &value);
+      if (kind == OwnProperty::kUnsafe) return false;
+      if (kind == OwnProperty::kData &&
+          (value->IsObject() || value->IsSymbol())) {
+        return false;
+      }
+    }
+    // Any level can be the stack holder, and a chain can cross realms.
+    v8::Local<v8::Context> realm;
+    if (!holder.As<v8::Object>()->GetCreationContext(isolate).ToLocal(
+            &realm)) {
+      return false;
+    }
+    if (realm == checkedRealm) continue;
+    if (!isRealmPrepareStackTraceInert(context, realm)) return false;
+    checkedRealm = realm;
   }
+  return true;

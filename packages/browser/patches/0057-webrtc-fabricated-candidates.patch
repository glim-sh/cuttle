+// cuttle: the --fingerprint-webrtc-ip mask. Written once on the renderer main
+// thread before any port exists, read on the network thread afterwards.
+IPAddress& CuttleForcedWebrtcIpStorage() {
+  static IPAddress* ip = new IPAddress();
+  return *ip;
+}
+
+// Chrome's mDNS responder hands out one name per address and keeps it, so two
+// peer connections on a page see the same .local host. Network thread only.
+const std::string& CuttleMdnsName(const IPAddress& ip) {
+  static auto* names = new std::map<IPAddress, std::string>();
+  auto [it, inserted] = names->try_emplace(ip);
+  if (inserted) {
+    it->second = CreateRandomUuid() + ".local";
+  }
+  return it->second;
+}

+// cuttle: with a forced WebRTC IP, or --fingerprint-webrtc-no-local-dns, a
+// lookup would go to the system resolver, not the proxy, and tell a page's
+// nameserver where the host is. Fail it, as a firewall blocking DNS would: TURN
+// over TCP or TLS then connects by hostname through the proxy, and a hostname
+// remote candidate is dropped.
+bool AsyncDnsAddressResolverImpl::CuttleFailLookup() {
+  static const bool no_local_dns =
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          cuttle::switches::kFingerprintWebrtcNoLocalDns);
+  if (webrtc::CuttleForcedWebrtcIp().IsNil() && !no_local_dns) {
+    return false;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      blink::BindOnce(&AsyncDnsAddressResolverImpl::OnAddressResolved,
+                      weak_factory_.GetWeakPtr(), Vector<net::IPAddress>()));
+  return true;
 }
 

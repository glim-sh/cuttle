# cuttle-stealth-chromium patch #10 - Notification.permission defaults to
# "default" under Cuttle fingerprint mode.
#
# Source: chromium 154.0.8037.57
#   third_party/blink/renderer/modules/notifications/notification.cc
diff --git a/third_party/blink/renderer/modules/notifications/notification.cc b/third_party/blink/renderer/modules/notifications/notification.cc
--- a/third_party/blink/renderer/modules/notifications/notification.cc
+++ b/third_party/blink/renderer/modules/notifications/notification.cc
@@ -30,10 +30,12 @@
 
 #include "third_party/blink/renderer/modules/notifications/notification.h"
 
+#include "base/command_line.h"
 #include <memory>
 #include <utility>
 
 #include "base/task/single_thread_task_runner.h"
+#include "chrome/common/cuttle_fingerprint_switches.h"
 #include "base/unguessable_token.h"
 #include "mojo/public/cpp/bindings/pending_remote.h"
 #include "third_party/blink/public/common/notifications/notification_constants.h"
@@ -66,7 +68,31 @@
 #include "third_party/blink/renderer/platform/wtf/std_lib_extras.h"
 
 namespace blink {
+namespace {
 
+bool CuttleNotificationPromptDefaultEnabled() {
+  auto* cl = base::CommandLine::ForCurrentProcess();
+  return cl->HasSwitch(cuttle::switches::kFingerprint) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintPlatform) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintBrand) ||
+         cl->HasSwitch(cuttle::switches::kFingerprintBrandVersion);
+}
+
+mojom::blink::PermissionStatus CuttleNotificationPromptDefault(
+    mojom::blink::PermissionStatus status) {
+  // cuttle-stealth #10: headless/fingerprint mode can surface "denied" even
+  // when a fresh real Chrome profile reports Notification.permission as
+  // "default". Convert that automation tell back to the prompt/default state.
+  if (status == mojom::blink::PermissionStatus::DENIED &&
+      CuttleNotificationPromptDefaultEnabled()) {
+    return mojom::blink::PermissionStatus::ASK;
+  }
+  return status;
+}
+
+}  // namespace
+
+
 Notification* Notification::Create(ExecutionContext* context,
                                    const String& title,
                                    const NotificationOptions* options,
@@ -435,6 +461,7 @@
 
   mojom::blink::PermissionStatus status =
       NotificationManager::From(context)->GetPermissionStatus();
+  status = CuttleNotificationPromptDefault(status);
 
   // Permission can only be requested from top-level frames and same-origin
   // iframes. This should be reflected in calls getting permission status.

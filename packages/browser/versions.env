# Single source of version truth for the stealth-Chromium build pipeline.
# Sourced by build/run-build.sh and the validate/ harness.

# Chromium / ungoogled-chromium base.
CHROMIUM_VERSION=151.0.7922.137
UC_TAG=151.0.7922.137-1                              # ungoogled-chromium git tag

# The clark parity oracle is retired at 151: clark is dormant at 148.0.7778.96
# (last release 2026-06-01) and no 151 reference tarball will ever exist. The
# gate is now our own: validate/smoke.py per persona, plus a baseline surface
# diff against our own previous release.

# Our own published bundles (GitHub release on glim-sh/cuttle), pinned by sha256
# and consumed by ops/docker/Dockerfile.
BROWSER_RELEASE_TAG=browser-v148.0.7778.96-2
BROWSER_ASSET_X64=stealth-chromium-linux-x64.tar.gz
BROWSER_ASSET_ARM64=stealth-chromium-linux-arm64.tar.gz
BROWSER_SHA256_X64=bd0a463b822ac6a6263374a264fc39ee19c28378f6111b42a1a4fc56353f24df
BROWSER_SHA256_ARM64=0668e018fdf3da6885fafae5c7598b758a1eb2e9fdd70218d3648db624a39ea2

# sccache cache cap on the mounted volume (both targets' worth).
SCCACHE_CACHE_SIZE=150G
